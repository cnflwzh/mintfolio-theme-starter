---
import type { HomePageData, PageProps } from '@mintfolio/core/astro';
import StarterLayout from '../layouts/StarterLayout.astro';

interface StarterSettings {
  readonly accentColor: string;
}

interface Props extends PageProps<StarterSettings, HomePageData> {}

const { theme, page } = Astro.props;
---

<StarterLayout seo={page.seo} siteTitle={theme.site.title} homeUrl={theme.urls.home()} accentColor={theme.settings.accentColor}>
  <h1>{page.title}</h1>
  <p>{page.description}</p>
  <ul>
    {page.posts.map((post) => <li><a href={post.url}>{post.title}</a> — {post.description}</li>)}
  </ul>
</StarterLayout>
